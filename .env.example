# ==============================================================================
# VASUDHA — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate values locally.
# 3. NEVER commit .env or any secret values to version control.
# ==============================================================================

# Runtime environment ('development', 'testing', or 'production')
ENVIRONMENT=

# Debug flag ('true' or 'false' - set to false in production)
DEBUG=

# Backend server host and port
BACKEND_HOST=
BACKEND_PORT=

# Database connection string (PostgreSQL + pgvector, or sqlite:///./darukaa_earth.db for local dev)
DATABASE_URL=

# AI Provider configurations
DEFAULT_LLM_PROVIDER=
LLM_MODEL=
DEFAULT_EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Gemini API Key (Server-side only; obtain from Google AI Studio / Google Cloud)
GEMINI_API_KEY=

# Public application hosting URL (e.g., Cloud Run or custom domain)
APP_URL=https://vasudha-o4fd.onrender.com

# Optional: Frontend API Base URL (defaults to /api/v1 proxy)
VITE_API_BASE_URL=


